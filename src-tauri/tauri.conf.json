{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSH Connector",
  "version": "1.2.0",
  "identifier": "dev.sshconnector.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SSH Connector",
        "width": 1180,
        "height": 740,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "dragDropEnabled": false,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,AutofillServerCommunication,SpareRendererForSitePerProcess --disable-background-networking --renderer-process-limit=1 --disable-gpu-shader-disk-cache"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
